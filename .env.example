# Copy this file to `.env` and fill in real values to enable live onboarding.

# Orchestrator server
HOST=0.0.0.0
PORT=4000
ORCHESTRATOR_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:4000
DEFAULT_REVIEWER=operator@example.com
NEXT_PUBLIC_DEFAULT_REVIEWER=operator@example.com

# Jira
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# Confluence
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# GitHub
GITHUB_TOKEN=ghp_xxx
# Optional GitHub App auth
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Postgres / pgvector
PGHOST=localhost
PGPORT=5432
PGDATABASE=nagini
PGUSER=nagini
PGPASSWORD=change-me
PGSSLMODE=prefer

# OpenAI embeddings
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
